# Node / React Native / Expo
node_modules/
.npm/
.pnpm-store/
.expo/
.expo-shared/
web-build/
dist/
build/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example

# Android / iOS build artifacts
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/*.iml
ios/Pods/
ios/build/
ios/*.xcworkspace
ios/*.xcodeproj/project.xcworkspace/
ios/*.xcuserdata/

# Java / Kotlin / Gradle
.gradle/
**/build/
*.class
*.apk
*.aab
*.dex
*.keystore
*.jks

# Python (backend if present)
__pycache__/
*.py[cod]
*.pyo
*.pyd
venv/
.venv/
ENV/
env/
.pytest_cache/
.mypy_cache/
.pyre/

# Prisma / database local files
prisma/*.db
prisma/*.db-journal
*.sqlite
*.sqlite3

# Misc generated files
*.orig
*.bak
*.cache
.cache/

# Keep lockfiles tracked
!package-lock.json
!yarn.lock
!pnpm-lock.yaml
